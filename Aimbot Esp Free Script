local CurrentY = 52

local function CreateToggle(Name, Setting)

	local Button = Instance.new("TextButton")

	Button.Size = UDim2.new(1, -24, 0, 40)
	Button.Position = UDim2.new(0, 12, 0, CurrentY)

	Button.BackgroundColor3 = Color3.fromRGB(28, 28, 35)
	Button.TextColor3 = Color3.new(1, 1, 1)
	Button.TextSize = 14
	Button.Font = Enum.Font.GothamBold

	Button.Parent = Main

	local Corner = Instance.new("UICorner")
	Corner.CornerRadius = UDim.new(0, 10)
	Corner.Parent = Button

	local function Refresh()
		if Settings[Setting] then
			Button.Text = Name .. ": ON"
			Button.BackgroundColor3 = Color3.fromRGB(50, 115, 70)
		else
			Button.Text = Name .. ": OFF"
			Button.BackgroundColor3 = Color3.fromRGB(28, 28, 35)
		end
	end

	Button.Activated:Connect(function()
		Settings[Setting] = not Settings[Setting]
		Refresh()
	end)

	Refresh()

	CurrentY += 46
end

