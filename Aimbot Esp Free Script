-- BUTTON FACTORY
--========================================================

local Buttons = {}

local function MakeToggle(text, setting)
	local Button = Instance.new("TextButton")

	Button.Size = UDim2.new(1, 0, 0, 55)
	Button.BackgroundColor3 = Color3.fromRGB(38, 38, 44)
	Button.TextColor3 = Color3.new(1,1,1)
	Button.TextSize = 17
	Button.Font = Enum.Font.GothamBold
	Button.TextXAlignment = Enum.TextXAlignment.Left
	Button.Parent = Container

	local Padding = Instance.new("UIPadding")
	Padding.PaddingLeft = UDim.new(0, 16)
	Padding.Parent = Button

	local Corner = Instance.new("UICorner")
	Corner.CornerRadius = UDim.new(0, 13)
	Corner.Parent = Button

	local function Refresh()
		if Settings[setting] then
			Button.Text = text .. "    ON"
			Button.BackgroundColor3 = Color3.fromRGB(40, 145, 75)
		else
			Button.Text = text .. "    OFF"
			Button.BackgroundColor3 = Color3.fromRGB(38, 38, 44)
		end
	end

	Button.Activated:Connect(function()
		Settings[setting] = not Settings[setting]
		Refresh()
	end)

	Buttons[setting] = Refresh
	Refresh()

	return Button
end

MakeToggle("ESP", "ESP")
MakeToggle("AIMBOT", "Aimbot")
MakeToggle("AUTO FIRE", "AutoFire")
MakeToggle("WALLBANG TEST", "WallbangTest")

